@model IEnumerable<Cliente>

<h1>Clientes</h1>
<hr />

<p>
    <a asp-action="CadastrarUsuario" class="btn btn-primary">Novo Usuario</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Nome)</th>
            <th>@Html.DisplayNameFor(m => m.Nascimento)</th>
            <th>@Html.DisplayNameFor(m => m.Sexo)</th>
            <th>@Html.DisplayNameFor(m => m.CPF)</th>
            <th>@Html.DisplayNameFor(m => m.Telefone)</th>
            <th>@Html.DisplayNameFor(m => m.Email)</th>
            <th>@Html.DisplayNameFor(m => m.Situacao)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nome</td>
                <td>@item.Nascimento.ToString("dd/MM/yyyy")</td>
                <td>@item.Sexo</td>
                <td>@item.CPF</td>
                <td>@item.Telefone</td>
                <td>@item.Email</td>
                <td>@item.Situacao</td>
            </tr>
        }
    </tbody>
</table>