<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Boricua</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Space+Mono:wght@400;700&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
    <!-- Bootstrap: necessário para as views que já existiam no projeto (Login, Cadastro, etc) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <header class="site-nav">
        <div class="nav-inner">
            <a asp-controller="Home" asp-action="Index" class="logo">boricua<span>.</span></a>
            <nav class="links">
                <a asp-controller="Home" asp-action="Index" asp-fragment="sobre">Sobre</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="temas">Cultura</a>
                <a asp-controller="Home" asp-action="Atracoes">Pontos Turísticos</a>
                <a asp-controller="Aluguel" asp-action="Index">Aluguel</a>
            </nav>
            <a asp-controller="Aluguel" asp-action="Index" class="nav-cta">Ver quartos</a>
        </div>
    </header>

    @RenderBody()

    <footer>
        <div class="container footer-inner">
            <div class="fnote">© 2026 boricua — protótipo de site cultural sobre Porto Rico.</div>
            <div class="social">
                <a href="#" aria-label="Instagram">◎</a>
                <a href="#" aria-label="Facebook">f</a>
                <a href="#" aria-label="LinkedIn">in</a>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
